[Unit]
Description=MCP HTTP Server Connection Monitor
After=network.target

[Service]
Type=simple
User=gotime2022
WorkingDirectory=/home/gotime2022/mcp-kernel-new
Environment="PATH=/home/gotime2022/mcp-kernel-new/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/home/gotime2022/mcp-kernel-new"
ExecStart=/home/gotime2022/mcp-kernel-new/.venv/bin/python /home/gotime2022/mcp-kernel-new/servers/http/mcp-connection-monitor.py
Restart=always
RestartSec=10
StandardOutput=append:/home/gotime2022/.mcp-persistent/monitor.log
StandardError=append:/home/gotime2022/.mcp-persistent/monitor-error.log

[Install]
WantedBy=multi-user.target