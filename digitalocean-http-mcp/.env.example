# Digital Ocean HTTP MCP Server Environment Variables

# REQUIRED: Your Digital Ocean API Token
# Get one from: https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_API_TOKEN=dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL: Server port (defaults to 8040)
DIGITALOCEAN_MCP_PORT=8040

# OPTIONAL: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# OPTIONAL: Default region for resource creation
DEFAULT_REGION=nyc3

# OPTIONAL: Default SSH key fingerprint
# Find with: doctl compute ssh-key list
DEFAULT_SSH_KEY=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx

# OPTIONAL: Enable request caching (reduces API calls)
ENABLE_CACHE=true
CACHE_TTL_SECONDS=300

# OPTIONAL: Webhook URL for notifications
# WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# OPTIONAL: Tags to apply to all created resources
DEFAULT_TAGS=mcp-managed,environment:production