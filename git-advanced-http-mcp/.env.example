# Git Advanced MCP Server Configuration

# Base repository path (default: current directory)
# This should point to the main git repository
GIT_BASE_REPO_PATH=/path/to/your/main/repo

# Worktree storage directory (default: .worktrees in repo)
# This is where agent-specific worktrees will be created
GIT_WORKTREE_BASE=/path/to/worktree/storage

# Server port (default: 8045)
GIT_ADVANCED_MCP_PORT=8045

# Optional: Git user configuration for commits
# GIT_USER_NAME="MCP Agent"
# GIT_USER_EMAIL="agent@mcp.local"

# Optional: Default branch for operations (default: main)
# GIT_DEFAULT_BRANCH=main

# Optional: Maximum worktrees per repository (default: unlimited)
# GIT_MAX_WORKTREES=20