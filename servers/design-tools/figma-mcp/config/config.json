{
    "server_name": "figma-design",
    "version": "1.0.0",
    "description": "Figma MCP Server for Design-to-Code Workflow",
    "author": "MCP Kernel Team",
    "port": 8031,
    "host": "0.0.0.0",
    "environment_variables": {
        "FIGMA_ACCESS_TOKEN": "Your Figma Personal Access Token",
        "SUPABASE_URL": "Your Supabase Project URL",
        "SUPABASE_SERVICE_KEY": "Your Supabase Service Role Key",
        "FIGMA_MCP_PORT": "8031"
    },
    "database": {
        "type": "supabase",
        "schema_version": "1.0.0",
        "migrations_path": "./migrations/"
    },
    "api": {
        "rate_limit": {
            "figma": {
                "requests_per_minute": 1000,
                "burst_limit": 100
            }
        },
        "cache": {
            "enabled": true,
            "ttl_seconds": 3600,
            "redis_url": "redis://localhost:6379"
        }
    },
    "components": {
        "supported_types": [
            "button", "card", "input", "select", "checkbox", 
            "radio", "switch", "badge", "avatar", "dialog",
            "alert", "tabs", "accordion", "separator", "tooltip", "form"
        ],
        "shadcn_version": "latest",
        "theme_support": ["light", "dark", "both"]
    },
    "logging": {
        "level": "INFO",
        "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
    }
}