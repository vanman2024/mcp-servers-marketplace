# Figma MCP Server Configuration Example
# Copy this file to .env and fill in your actual values

# ==============================================================================
# REQUIRED: Figma Authentication
# ==============================================================================
# You need ONE of these (FIGMA_PAT is preferred):

# Option 1: Figma Personal Access Token (Recommended)
# Get from: https://www.figma.com/developers/access-tokens
# Required scope: "File content" (read access to files)
# Format: starts with "figd_" or "figp_"
FIGMA_PAT=figd_YOUR_ACTUAL_TOKEN_HERE

# Option 2: Alternative name for Figma token
# FIGMA_ACCESS_TOKEN=figd_YOUR_ACTUAL_TOKEN_HERE

# ==============================================================================
# REQUIRED: Supabase Configuration
# ==============================================================================
# Get these from your Supabase project dashboard:
# https://app.supabase.com -> Your Project -> Settings -> API

# Your Supabase project URL
# Format: https://YOUR_PROJECT_ID.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase service_role key (NOT the anon key!)
# This key has full access to your database - keep it secret!
# Format: Long JWT token, typically 200+ characters
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ACTUAL_SERVICE_KEY_HERE

# ==============================================================================
# OPTIONAL: Server Configuration
# ==============================================================================

# Port for the MCP server (default: 8031)
FIGMA_MCP_PORT=8031

# Enable debug logging (default: false)
# Set to true, 1, or yes to enable verbose logging
FIGMA_DEBUG=false

# ==============================================================================
# TROUBLESHOOTING TIPS
# ==============================================================================
# 1. Figma token issues:
#    - Ensure your token has "File content" read permissions
#    - Tokens expire after 90 days of inactivity
#    - Personal tokens start with "figd_" or "figp_"
#
# 2. Supabase issues:
#    - Use the service_role key, NOT the anon/public key
#    - Ensure your database has the required tables (run migrations)
#    - Check that your project is active (not paused)
#
# 3. Connection issues:
#    - Check your internet connection
#    - Verify firewall/proxy settings
#    - Try the health_check endpoint: http://localhost:8031/health
#
# 4. To test your configuration:
#    - Set FIGMA_DEBUG=true for detailed logs
#    - Run: ./start.sh
#    - Check logs for specific error messages