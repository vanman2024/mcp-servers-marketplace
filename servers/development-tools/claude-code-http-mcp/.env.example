# Claude Code MCP Server Environment Variables

# API Keys (REQUIRED for full functionality)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
CLAUDE_CODE_MCP_PORT=8035
CLAUDE_CODE_DEBUG=false
CLAUDE_CODE_LOG_LEVEL=INFO

# Integration Settings
RESPONSES_API_INTEGRATION=true
PARALLEL_INSTANCES_MAX=5
DEFAULT_EXECUTION_MODE=primary_developer
DEFAULT_COVERAGE_TARGET=95

# SynapseAI Integration
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
GITHUB_TOKEN=your_github_token
VERCEL_TOKEN=your_vercel_token

# Performance Settings
MAX_CLAUDE_TURNS=10
HANDOFF_TIMEOUT_MS=5000
COORDINATION_LATENCY_TARGET_MS=100

# Quality Assurance
ENFORCE_TEST_COVERAGE=true
ENABLE_SECURITY_SCANNING=true
ENABLE_PERFORMANCE_MONITORING=true