  "connection_patterns": {
    "direct_http": {
      "description": "Direct HTTP connection to MCP server",
      "example": "http://localhost:8040/mcp/tools/get_marketing_sections",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer ${SUPABASE_SERVICE_KEY}"
      }
    },
    "api_gateway": {
      "description": "Centralized API gateway for all MCP servers",
      "baseUrl": "https://api.synapseai.dev/mcp/",
      "pattern": "{baseUrl}/{server}/{endpoint}",
      "example": "https://api.synapseai.dev/mcp/figma-marketing/tools/get_marketing_sections"
    },
    "project_specific": {
      "description": "Project-specific MCP configuration",
      "pattern": "Each project can override server URLs and add custom servers",
      "example": {
        "projectId": "project-123",
        "overrides": {
          "figma-marketing": {
            "url": "https://custom-domain.com/marketing-mcp/"
          }
        }
      }
    }
  },
  "authentication": {
    "methods": {
      "api_key": "Bearer token in Authorization header",
      "jwt": "JWT token for project-specific access",
      "oauth": "OAuth2 for user-specific access"
    },
    "required_env_vars": [
      "SUPABASE_URL",
      "SUPABASE_SERVICE_KEY",
      "ANTHROPIC_API_KEY",
      "OPENAI_API_KEY"
    ]
  },
  "discovery": {
    "endpoints": {
      "list_servers": "/mcp/servers",
      "server_info": "/mcp/servers/{server_name}",
      "tool_info": "/mcp/servers/{server_name}/tools/{tool_name}",
      "health_check": "/mcp/health"
    },
    "auto_update": {
      "enabled": true,
      "frequency": "hourly",
      "webhook": "https://api.synapseai.dev/webhooks/mcp-registry-update"
    }
  },
  "usage_examples": {
    "curl": {
      "list_tools": "curl -H 'Authorization: Bearer ${API_KEY}' http://localhost:8040/mcp/tools",
      "call_tool": "curl -X POST -H 'Content-Type: application/json' -H 'Authorization: Bearer ${API_KEY}' -d '{\"name\":\"get_marketing_sections\",\"arguments\":{\"category\":\"hero\"}}' http://localhost:8040/mcp/tools/get_marketing_sections"
    },
    "python": {
      "description": "Python client example",
      "code": "import requests\n\nresponse = requests.post(\n    'http://localhost:8040/mcp/tools/get_marketing_sections',\n    headers={'Authorization': f'Bearer {api_key}'},\n    json={'category': 'hero', 'limit': 10}\n)"
    },
    "javascript": {
      "description": "JavaScript/TypeScript client example",
      "code": "const response = await fetch('http://localhost:8040/mcp/tools/get_marketing_sections', {\n    method: 'POST',\n    headers: {\n        'Content-Type': 'application/json',\n        'Authorization': `Bearer ${apiKey}`\n    },\n    body: JSON.stringify({ category: 'hero', limit: 10 })\n});"
    }
  }
