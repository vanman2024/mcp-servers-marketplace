{
  "server": {
    "name": "Figma E-commerce MCP Server",
    "version": "1.0.0",
    "port": 8041,
    "host": "localhost",
    "environment": "development"
  },
  "database": {
    "provider": "supabase",
    "required_env_vars": [
      "SUPABASE_URL",
      "SUPABASE_SERVICE_KEY"
    ],
    "connection_pool": {
      "min_connections": 3,
      "max_connections": 25,
      "connection_timeout": 30,
      "idle_timeout": 300
    }
  },
  "specialization": {
    "focus": "ecommerce",
    "primary_categories": [
      "Product Grids",
      "Product Detail",
      "Cart Panels",
      "Checkout Screens",
      "Product Reviews",
      "Category Filters",
      "Order Summaries",
      "Wishlist Grids"
    ],
    "advanced_features": [
      "Inventory management",
      "Dynamic pricing",
      "Payment processing",
      "Shipping calculations",
      "Product recommendations",
      "Cart abandonment recovery",
      "Multi-currency support",
      "Tax calculations"
    ]
  },
  "performance": {
    "cache_ttl": 1800,
    "max_requests_per_minute": 150,
    "response_compression": true,
    "enable_cdn": true,
    "product_cache_strategy": "aggressive"
  },
  "logging": {
    "level": "INFO",
    "format": "json",
    "retention_days": 30,
    "metrics_enabled": true,
    "transaction_logging": true
  }
}