# Supabase MCP Server Configuration

# Required: Your Supabase project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Required: Service role key for admin operations
# Get this from: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: User access token for organization/project operations
# Only needed for organization and project management tools
SUPABASE_ACCESS_TOKEN=sbp_your_access_token_here

# Optional: Server port (default: 8034)
SUPABASE_MCP_PORT=8034

# Optional: Array parameters fix import path
# Used for fixing array parameter handling in some operations
ARRAY_PARAMS_FIX_PATH=../array_params_fix.py