# ===================================================================
# ngrok HTTP MCP Server Configuration
# Copy this file to .env and fill in your actual values
# ===================================================================

# ngrok API Configuration
# Get your API key from: https://dashboard.ngrok.com/api/keys
NGROK_API_KEY=your_ngrok_api_key_here

# ngrok Authentication Token (for tunnel creation)
# Get your authtoken from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Server Configuration
NGROK_MCP_PORT=8030
NGROK_MCP_HOST=0.0.0.0

# ngrok Configuration
NGROK_DEFAULT_REGION=us
NGROK_DEFAULT_SUBDOMAIN=your-app-name

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Development Settings
DEVELOPMENT_MODE=false
DEBUG_TUNNELS=false

# Security Settings
# Set to true in production environments
REQUIRE_HTTPS=false
ENABLE_CORS=true
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Performance Settings
MAX_TUNNELS=10
TUNNEL_TIMEOUT=300
CONNECTION_TIMEOUT=30

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_INTERVAL=60
HEALTH_CHECK_INTERVAL=30

# Optional: Custom Domain Configuration
# NGROK_CUSTOM_DOMAIN=your-custom-domain.com
# NGROK_DOMAIN_CERT_PATH=/path/to/cert.pem
# NGROK_DOMAIN_KEY_PATH=/path/to/key.pem

# Optional: Webhook Configuration for CI/CD Integration
# WEBHOOK_SECRET=your_webhook_secret
# GITHUB_WEBHOOK_URL=https://api.github.com/repos/your-repo/dispatches
# GITHUB_TOKEN=your_github_token

# Optional: Team/Organization Settings
# NGROK_TEAM_ID=your_team_id
# NGROK_ORG_DOMAIN=your-org.ngrok.io

# Optional: Advanced Security Settings
# OAUTH_CLIENT_ID=your_oauth_client_id
# OAUTH_CLIENT_SECRET=your_oauth_client_secret
# JWT_SECRET=your_jwt_secret_key
# API_RATE_LIMIT=100

# Optional: Integration Settings
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/discord/webhook
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your/teams/webhook

# Optional: Database Configuration (for advanced features)
# DATABASE_URL=postgresql://user:pass@localhost/ngrok_mcp
# REDIS_URL=redis://localhost:6379

# Optional: Cloud Provider Integration
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AZURE_TENANT_ID=your_azure_tenant_id
# AZURE_CLIENT_ID=your_azure_client_id
# AZURE_CLIENT_SECRET=your_azure_client_secret
# GCP_PROJECT_ID=your_gcp_project_id
# GCP_SERVICE_ACCOUNT_KEY=path/to/service-account.json