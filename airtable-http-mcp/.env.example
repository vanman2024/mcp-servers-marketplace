# Airtable API Authentication
# Create a Personal Access Token at: https://airtable.com/create/tokens
AIRTABLE_PERSONAL_ACCESS_TOKEN=your_personal_access_token_here

# Alternative: Legacy API key (deprecated but still supported)
# AIRTABLE_API_KEY=your_api_key_here

# Server Configuration (optional)
AIRTABLE_MCP_PORT=8040

# Logging Level (optional)
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO