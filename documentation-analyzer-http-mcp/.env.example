# Documentation Analyzer MCP Server Configuration

# Server Port (default: 8036)
DOCUMENTATION_ANALYZER_MCP_PORT=8036

# AI API Keys (optional - for enhanced AI features)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Cache Configuration
DOCUMENTATION_ANALYZER_CACHE_DIR=~/.documentation-analyzer/cache
DOCUMENTATION_ANALYZER_MAX_FILE_SIZE=10485760  # 10MB in bytes

# Quality Analysis Thresholds
DOCUMENTATION_MIN_WORD_COUNT=100
DOCUMENTATION_MAX_TYPO_RATIO=0.02
DOCUMENTATION_MIN_HEADER_RATIO=0.1

# Search Configuration
DOCUMENTATION_MAX_SEARCH_RESULTS=50
DOCUMENTATION_SEARCH_TIMEOUT=30

# Debug and Logging
DOCUMENTATION_ANALYZER_DEBUG=false
DOCUMENTATION_ANALYZER_LOG_LEVEL=INFO

# Integration Settings
ENABLE_AI_FEATURES=true
AI_PROVIDER=openai  # or 'anthropic'
AI_MODEL_SUMMARIZATION=gpt-3.5-turbo
AI_MODEL_CATEGORIZATION=gpt-3.5-turbo  
AI_MODEL_QUALITY=gpt-4